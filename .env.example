# Copy to .env and fill in. Never commit .env.

# --- Unicommerce / Uniware (read-only) ---
# One block per Uniware login. Add more with any key: _C_, _NEWME_, ...
# Leave all of them empty to run on mock data.
#
# TENANT:   the part before .unicommerce.com in the Uniware web address
# FACILITY: the facility code to sync (sent as the Facility header)

UNICOMMERCE_ACCOUNT_A_TENANT=
UNICOMMERCE_ACCOUNT_A_FACILITY=
UNICOMMERCE_ACCOUNT_A_USERNAME=
UNICOMMERCE_ACCOUNT_A_PASSWORD=

UNICOMMERCE_ACCOUNT_B_TENANT=
UNICOMMERCE_ACCOUNT_B_FACILITY=
UNICOMMERCE_ACCOUNT_B_USERNAME=
UNICOMMERCE_ACCOUNT_B_PASSWORD=

# Requests in flight at once, per account
UNICOMMERCE_MAX_CONCURRENCY=5

# Force mock data even when accounts are set: mock | live
UNICOMMERCE_MODE=

# --- Sync ---
# Days of history to load on the first run
BACKFILL_DAYS=30

# Minutes between automatic syncs (short, so processed returns leave the pending list quickly)
SYNC_INTERVAL_MIN=5

# --- Server ---
PORT=4000

# --- Web app ---
WEB_PORT=5180


# --- AI ---
# Smart checks use every AI engine with a key below, in turn: Groq, Gemini,
# Meta, then OpenAI. Models are picked automatically from each engine's own
# model list; a busy or used-up model is skipped and the next one is tried.
# Leave a key empty to leave that engine out. Groq and Gemini are free.
# Groq (free, console.groq.com): fastest, about one photo check per minute
GROQ_KEY=
# Gemini (free, aistudio.google.com)
GEMINI_API_KEY=
# Meta Model API key, from dev.meta.ai (paid: billing must be set up there)
META_KEY=
# Optional, your own key only
OPENAI_KEY=
# Optional: engine order, e.g. groq,gemini,meta,openai
AI_ENGINES=
# Optional: pin models instead of picking them, e.g. GEMINI_MODELS=gemini-3.5-flash-lite
GROQ_MODELS=
GEMINI_MODELS=
META_MODELS=
OPENAI_MODELS=
# auto (default) | groq | gemini | meta | openai | claude-cli | mock | off
AI_PROVIDER=
# Model alias for the Claude CLI: sonnet (default), opus, haiku
AI_MODEL=

# Briefs written automatically (24h times, comma-separated)
BRIEF_DAILY_AT=09:00
BRIEF_HANDOVER_AT=14:00,22:00
# Optional: post briefs to a team channel (Slack / Teams / Google Chat incoming-webhook URL)
BRIEF_WEBHOOK_URL=

# --- Dispatch emails ---
# Sent when a dispatch handover is submitted. Demo: Uniware masks customer
# emails, so all of them go to MAIL_DEMO_TO (unset, none are sent).
MAIL_FROM=
MAIL_DEMO_TO=
# Microsoft Graph, required to send: an app registration in
# Microsoft Entra with the Mail.Send application permission (admin consent).
# MAIL_FROM must be a real mailbox in that tenant. MS_* names work too.
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
# Where "View emails" goes (default: Outlook Sent Items)
MAIL_INBOX_URL=

# Minutes between checks for orders cancelled after manifest
GUARD_INTERVAL_MIN=2

# --- Working hours (for the working-hours clock) ---
WORK_HOURS=10:00-18:00
WORK_DAYS=Mon,Tue,Wed,Thu,Fri,Sat,Sun
# Days off, comma-separated YYYY-MM-DD
HOLIDAYS=
